# Production build (GitHub Pages). Keeps the public site in normal mode:
#  - real auth/guest screen, first-run-only onboarding, Free tier by default.
# The in-app developer tier-switcher appears only for admin accounts, decided
# by the server (the locked `admins` table + is_admin(), see supabase/admins.sql).
# No unlock code ships in the bundle, so regular visitors never see it.
VITE_DEV_MODE=false

# Backend: Supabase — real accounts that sync across devices. The publishable
# key is public by design; security comes from Row-Level Security.
VITE_SUPABASE_URL=https://eqmucfqyznbnvuyvrgpy.supabase.co
