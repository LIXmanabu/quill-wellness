# Production build (GitHub Pages). Keeps the public site in normal mode:
#  - real auth/guest screen, first-run-only onboarding, Free tier by default.
# The in-app developer tier-switcher still works via its unlock code; it is
# gated per-browser, so regular visitors never see it.
VITE_DEV_MODE=false

# No backend — auth + data are local-only (localStorage on each device).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
